# Gerado pela role ora_db_software. 0600, dono {{ ora_owner }}, apagado ao fim (19c ladbi,
# "Preparing Response Files"). Chaves do template oficial install/response/db_install.rsp (19.3).
oracle.install.responseFileVersion=/oracle/install/rspfmt_dbinstall_response_schema_v19.0.0
oracle.install.option=INSTALL_DB_SWONLY
UNIX_GROUP_NAME={{ ora_install_group }}
INVENTORY_LOCATION={{ ora_inventory_dir }}
ORACLE_HOME={{ ora_db_home }}
ORACLE_BASE={{ ora_base }}
oracle.install.db.InstallEdition={{ ora_db_edition }}
oracle.install.db.OSDBA_GROUP={{ ora_db_osdba }}
oracle.install.db.OSOPER_GROUP={{ ora_db_osoper }}
oracle.install.db.OSBACKUPDBA_GROUP={{ ora_db_osbackupdba }}
oracle.install.db.OSDGDBA_GROUP={{ ora_db_osdgdba }}
oracle.install.db.OSKMDBA_GROUP={{ ora_db_oskmdba }}
oracle.install.db.OSRACDBA_GROUP={{ ora_db_osracdba }}
# false = root.sh manual ("To execute the root script manually"); a role roda o root.sh como root.
oracle.install.db.rootconfig.executeRootScript=false
